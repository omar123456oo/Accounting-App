PORT=3000
REGISTRATION_OPEN=true
NODE_ENV=development
# Single-node replica set from docker-compose (transactions need one). Dev only: no auth.
MONGODB_URI=mongodb://localhost:27017/accounting?replicaSet=rs0&directConnection=true
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/accounting
MONGODB_AUTO_INDEX=true

# --- Smart documents -------------------------------------------------------------------------
# Original PDFs are kept here (not in MongoDB). Use a persistent, backed-up path in production.
DOCS_STORAGE_DIR=./storage/documents
DOCS_MAX_UPLOAD_MB=20
# AI field extraction. Without a key the text is still extracted and the document opens for manual entry.
DOCS_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DOCS_AI_MODEL=claude-sonnet-5-5
# OCR for scanned pages: none | tesseract. Tesseract downloads language data on first use unless DOCS_OCR_LANG_PATH points at a folder holding it.
DOCS_OCR_PROVIDER=none
DOCS_OCR_LANGS=eng+ara
# Job worker and reminder scheduler inside the API process. Set false to run `npm run docs:tick` from cron.
DOCS_SCHEDULER=true
APP_URL=http://localhost:4200
# E-mail (Mailpit in docker-compose listens on 1025). Leave SMTP_HOST empty to disable e-mail: reminders then go in-app only and are never reported as e-mailed.
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=Accounting Office <no-reply@localhost>
