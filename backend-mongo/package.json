{
  "name": "accounting-api-mongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:sync-roles": "tsx src/scripts/sync-roles.ts",
    "hr:check": "tsx src/scripts/hr-smoke.ts",
    "leave:check": "tsx src/scripts/leave-smoke.ts",
    "db:check": "tsx src/scripts/smoke.ts",
    "api:check": "tsx src/scripts/api-smoke.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
