APP_NAME=Accounting
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Cairo

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=accounting
DB_USERNAME=acct_app
DB_PASSWORD=app_dev_only
DB_OWNER_USERNAME=acct_owner
DB_OWNER_PASSWORD=owner_dev_only

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@accounting.test
MAIL_FROM_NAME="${APP_NAME}"

# MinIO speaks the S3 protocol. Used from Phase 2 (documents).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio_dev
AWS_SECRET_ACCESS_KEY=minio_dev_only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=accounting
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SESSION_DRIVER=database
SESSION_DOMAIN=localhost
QUEUE_CONNECTION=database
CACHE_STORE=database
SANCTUM_STATEFUL_DOMAINS=localhost:4200

# Whether chief accountants see every client (true) or only assigned ones (false). Decide with the office.
ACCESS_CHIEF_ACCOUNTANT_OFFICE_WIDE=true

# The API docs page (/docs/api) is available when APP_ENV=local. Set true to expose it elsewhere; leave false in production.
API_DOCS_ENABLED=false

FRONTEND_URL=http://localhost:4200
REGISTRATION_OPEN=true
